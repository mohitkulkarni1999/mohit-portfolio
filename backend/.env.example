# Production (Supabase) - set these in Vercel project env vars
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres
JWT_SECRET=your_super_secret_key_change_this_in_production
CORS_ORIGIN=https://your-frontend.vercel.app

# Local development - only used when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=portfolio_db
PORT=5000
