# Production (Supabase) - set these in Vercel project env vars
# The Vercel "Supabase" integration auto-creates POSTGRES_URL (pooler) /
# POSTGRES_URL_NON_POOLING (direct). db.js uses DATABASE_URL, then POSTGRES_URL,
# then SUPABASE_DB_URL, then DIRECT_URL.
DATABASE_URL=postgres://postgres.[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET=your_super_secret_key_change_this_in_production
CORS_ORIGIN=https://your-frontend.vercel.app

# Local development - only used when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=portfolio_db
PORT=5000
